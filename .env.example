# Copy to .env for local development:  cp .env.example .env
# (Prisma and Next.js both read .env. On Vercel, set these in Project → Settings → Environment Variables.)

# --- Database (PostgreSQL) ---------------------------------------------------
# Pooled connection used by the app at runtime. On Vercel + Neon this is the pooled
# URL (host contains "-pooler"). Locally, `npm run db:local` starts an embedded Postgres here:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/venturesphere"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/venturesphere"

# --- Auth --------------------------------------------------------------------
# Secret used to sign session cookies (HS256 JWT). 32+ random chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: session cookies are `Secure` when NODE_ENV=production. Set to "false" only to
# try the production build (`npm start`) over plain http (e.g. in Safari on localhost).
# COOKIE_SECURE="false"

# --- Pitch-deck storage -----------------------------------------------------
# When set (Vercel → Storage → Blob), decks go to Vercel Blob; otherwise to ./uploads on disk.
# BLOB_READ_WRITE_TOKEN=""
# Access mode of your Blob store: "private" (recommended) or "public". Either way decks are only
# ever served through the auth-checked /api/startups/:id/deck route under random 128-bit paths.
# BLOB_ACCESS="private"
# Local-disk location when Blob is not configured (default ./uploads):
# UPLOAD_DIR="./uploads"

# --- Seeding ------------------------------------------------------------------
# Password for the demo VC account created by `npm run db:seed` (default: demo12345).
# Change it for any public deployment (or afterwards: npm run user:password -- <email> <new>).
# DEMO_VC_PASSWORD=""
